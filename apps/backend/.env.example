# Application
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200

# Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Data Source (Yahoo Finance tidak perlu key)
# Untuk broker data, isi jika punya akses RTI/Stockbit API
RTI_API_KEY=
STOCKBIT_API_KEY=

# Cron Schedule (format cron, default: Senin-Jumat 16:15 WIB = 09:15 UTC)
EOD_CRON_SCHEDULE=15 9 * * 1-5
